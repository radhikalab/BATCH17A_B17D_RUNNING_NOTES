 cat /opt/playbooks/httpd_setup.yaml


---
- name: Install and Configure Apache HTTP Server
  hosts: appservers
  become: yes

  tasks:
    - name: Install httpd
      yum:
        name: httpd
        state: present

    - name: Start and enable httpd service  ## systemctl start httpd && systemctl enable httpd 
      service:
        name: httpd
        state: started
        enabled: yes

    - name: Deploy index.html
      copy:
        src: /opt/index.html
        dest: /var/www/html/index.html
      tags: copy_index
